{
  "name": "homebridge-dyson-solarcycle-morph",
  "displayName": "Dyson Solarcycle Morph",
  "version": "0.3.0",
  "description": "Homebridge plugin for the Bluetooth LE controlled Dyson Solarcycle/Lightcycle Morph task light",
  "license": "MIT",
  "author": "Oliver Rummeyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rummeyer/homebridge-dyson-solarcycle-morph.git"
  },
  "bugs": {
    "url": "https://github.com/rummeyer/homebridge-dyson-solarcycle-morph/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "dyson-morph-pair": "dist/cli/pair.js"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "dyson",
    "solarcycle",
    "lightcycle",
    "morph",
    "cd06",
    "bluetooth",
    "ble",
    "light",
    "homekit"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/pair.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.ts",
    "prepublishOnly": "npm run clean && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "dbus-next": "^0.10.2",
    "node-ble": "^1.13.0",
    "node-persist": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/node-persist": "^3.1.8",
    "homebridge": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "tools",
    "docs",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/rummeyer/homebridge-dyson-solarcycle-morph#readme",
  "funding": "https://github.com/sponsors/rummeyer",
  "type": "module"
}
